---
import { PROJECTS } from '../config';
import SectionParticleReveal from './SectionParticleReveal.astro';
import GlassCard from './GlassCard.astro';
import MockupEcommerce from './MockupEcommerce.astro';
import MockupDashboard from './MockupDashboard.astro';
import MockupLanding from './MockupLanding.astro';
import ScrollReveal from './ScrollReveal.astro';

const MOCKUPS = {
  ecommerce: MockupEcommerce,
  dashboard: MockupDashboard,
  landing: MockupLanding,
};
---

<SectionParticleReveal radius={350}>
  <section id="projets" class="section" aria-labelledby="projects-title">
    <div class="container">
      <ScrollReveal threshold={0.15}>
        <span class="section-eyebrow reveal">Portfolio</span>
        <h2 id="projects-title" class="section-title reveal reveal-delay-1">Projets de Démonstration</h2>
        <div class="gold-line reveal reveal-delay-2"></div>
        <p class="section-subtitle reveal reveal-delay-2">Exploration technique et design sur des thématiques variées.</p>
      </ScrollReveal>

      <div class="grid grid-3">
        {PROJECTS.map((project, i) => {
          const Mockup = MOCKUPS[project.mockupType as keyof typeof MOCKUPS];
          return (
            <ScrollReveal threshold={0.2}>
              <GlassCard key={project.id}>
                <article class="project-item reveal reveal-shimmer" data-glass-target style={`transition-delay: ${i * 100}ms`}>
                  <div class="project-badge">Démonstration</div>
                  <div class="project-mockup">
                    {Mockup && <Mockup />}
                  </div>
                  <h3 class="project-item-title">{project.title}</h3>
                  <p class="project-item-tagline">{project.tagline}</p>
                  <div class="project-tags">
                    {project.tags.slice(0, 3).map((tag, ti, arr) => (
                      <>
                        <span>{tag}</span>
                        {ti < arr.length - 1 && <span class="tag-separator">·</span>}
                      </>
                    ))}
                  </div>
                </article>
              </GlassCard>
            </ScrollReveal>
          )
        })}
      </div>
    </div>
  </section>
</SectionParticleReveal>

<style>
  .project-item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-badge {
    align-self: flex-start;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid var(--color-gold);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .project-mockup {
    background: var(--color-bg);
    border-radius: var(--radius-md);
    height: 180px;
    margin-bottom: var(--space-6);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .project-item-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .project-item-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    gap: var(--space-2);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .project-tags span {
    font-size: 12px;
    color: var(--color-text-muted);
    background: var(--color-bg-elevated);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .tag-separator {
    font-size: 12px;
    color: var(--color-text-dim);
    padding: 0 2px;
  }
</style>