---
import { PROJECTS } from '../config';
import SectionParticleReveal from './SectionParticleReveal.astro';
import GlassCard from './GlassCard.astro';
import MockupEcommerce from './MockupEcommerce.astro';
import MockupDashboard from './MockupDashboard.astro';
import MockupLanding from './MockupLanding.astro';

const MOCKUPS = {
  ecommerce: MockupEcommerce,
  dashboard: MockupDashboard,
  landing: MockupLanding,
};
---

<SectionParticleReveal radius={350}>
  <section id="projets" class="section" aria-labelledby="projects-title">
    <div class="container">
      <span class="section-eyebrow">Portfolio</span>
      <h2 id="projects-title" class="section-title">Projets de Démonstration</h2>
      <div class="gold-line"></div>
      <p class="section-subtitle">Exploration technique et design sur des thématiques variées.</p>

      <div class="grid grid-3">
        {PROJECTS.map(project => {
          const Mockup = MOCKUPS[project.mockupType as keyof typeof MOCKUPS];
          return (
            <GlassCard key={project.id}>
              <article class="project-item" data-glass-target>
                <div class="project-badge">Démonstration</div>
                <div class="project-mockup">
                  {Mockup && <Mockup />}
                </div>
                <h3 class="project-item-title">{project.title}</h3>
                <p class="project-item-tagline">{project.tagline}</p>
                <div class="project-tags">
                  {project.tags.slice(0, 3).map(tag => <span>{tag}</span>)}
                </div>
              </article>
            </GlassCard>
          )
        })}
      </div>
    </div>
  </section>
</SectionParticleReveal>

<style>
  .project-item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-badge {
    align-self: flex-start;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid var(--color-gold);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .project-mockup {
    background: var(--color-bg);
    border-radius: var(--radius-md);
    height: 180px;
    margin-bottom: var(--space-6);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .project-item-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .project-item-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    gap: var(--space-2);
  }

  .project-tags span {
    font-size: 10px;
    color: var(--color-text-dim);
    background: var(--color-bg-alt);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }
</style>