---
import { PROCESS } from '../config';
---

<section id="processus" class="section" aria-labelledby="process-title">
  <div class="container">
    <p class="reveal section-eyebrow">Processus</p>
    <h2 id="process-title" class="reveal reveal-delay-1 section-title">
      Comment je travaille
    </h2>
    <div class="gold-line reveal reveal-delay-2" aria-hidden="true"></div>
    <p class="reveal reveal-delay-2 section-subtitle">
      Un processus clair et collaboratif, de la première discussion à la mise en ligne.
    </p>

    <div class="process-timeline">
      {PROCESS.map((step, i) => (
        <div
          class="process-step reveal reveal-delay-{Math.min(i + 1, 4)}"
          key={step.step}
        >
          <div class="process-step-number">{String(step.step).padStart(2, '0')}</div>
          <div class="process-step-content">
            <h3 class="process-step-title">{step.title}</h3>
            <p class="process-step-desc">{step.description}</p>
          </div>
          {i < PROCESS.length - 1 && (
            <div class="process-step-connector" aria-hidden="true"></div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-eyebrow {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .process-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
  }

  .process-step {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: var(--space-6);
    position: relative;
  }

  .process-step-number {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-gold);
    opacity: 0.6;
    line-height: 1;
    padding-top: var(--space-1);
  }

  .process-step-content {
    padding-bottom: var(--space-10);
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-6);
    position: relative;
  }

  .process-step-content::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 6px;
    width: 9px;
    height: 9px;
    background: var(--color-gold);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--color-bg);
  }

  .process-step-connector {
    position: absolute;
    left: 28px;
    top: 100%;
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  .process-step-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .process-step-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .process-step {
      grid-template-columns: 40px 1fr;
      gap: var(--space-4);
    }
    .process-step-number { font-size: var(--text-2xl); }
    .process-step-content { padding-left: var(--space-4); }
    .process-step-content::before { left: -3px; }
    .process-step-connector { left: 19px; }
  }
</style>
