---
import { SERVICES } from '../config';
import SectionParticleReveal from './SectionParticleReveal.astro';
import GlassCard from './GlassCard.astro';
---

<SectionParticleReveal radius={300}>
  <section id="services" class="section section-alt" aria-labelledby="services-title">
    <div class="container">
      <span class="section-eyebrow">Services</span>
      <h2 id="services-title" class="section-title">Ce que je propose</h2>
      <div class="gold-line"></div>
      <p class="section-subtitle">Des prestations sur-mesure pour donner vie à vos projets numériques.</p>

      <div class="grid grid-2">
        {SERVICES.map(service => (
          <GlassCard key={service.title}>
            <div data-glass-target class="service-item">
              <h3 class="service-title">{service.title}</h3>
              <p class="service-description">{service.description}</p>
            </div>
          </GlassCard>
        ))}
      </div>
    </div>
  </section>
</SectionParticleReveal>

<style>
  .service-item {
    padding: var(--space-4);
  }

  .service-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-gold);
    margin-bottom: var(--space-4);
  }

  .service-description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }
</style>