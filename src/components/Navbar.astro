---
import { PERSONAL, SITE } from '../config';
---

<nav class="navbar" aria-label="Navigation principale">
  <div class="container navbar-inner">
    <a href={`${import.meta.env.BASE_URL || '/'}`} class="navbar-brand" aria-label="Retour à l'accueil">
      <span class="navbar-logo">LMV Digital</span>
    </a>

    <button
      class="navbar-toggle"
      aria-expanded="false"
      aria-controls="navbar-menu"
      aria-label="Ouvrir le menu"
    >
      <span class="navbar-toggle-icon"></span>
      <span class="navbar-toggle-icon"></span>
      <span class="navbar-toggle-icon"></span>
    </button>

    <div id="navbar-menu" class="navbar-menu-container">
      <ul class="navbar-menu">
        <li><a href="#apropos" class="navbar-link">À propos</a></li>
        <li><a href="#competences" class="navbar-link">Compétences</a></li>
        <li><a href="#projets" class="navbar-link">Projets</a></li>
        <li><a href="#services" class="navbar-link">Services</a></li>
        <li><a href="#processus" class="navbar-link">Processus</a></li>
        <li><a href="#contact" class="navbar-link">Contact</a></li>
      </ul>
    </div>

    <a href="#contact" class="btn btn-primary navbar-cta">
      Me contacter
    </a>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(7, 7, 8, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--color-border);
    height: var(--nav-height);
    display: flex;
    align-items: center;
    transition: background var(--transition-base), border-color var(--transition-base);
  }

  .navbar.scrolled {
    background: rgba(7, 7, 8, 0.95);
    border-bottom-color: var(--color-gold-border);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .navbar-brand {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.05em;
  }

  .navbar-menu-container {
    display: none;
  }

  .navbar-menu {
    display: flex;
    gap: var(--space-2);
  }

  .navbar-link {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .navbar-link:hover {
    color: var(--color-gold);
    background: var(--color-gold-subtle);
  }

  .navbar-cta {
    display: none;
    padding: var(--space-2) var(--space-6);
  }

  .navbar-toggle {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-2);
    z-index: 110;
  }

  .navbar-toggle-icon {
    width: 24px;
    height: 2px;
    background: var(--color-gold);
    border-radius: 2px;
    transition: all var(--transition-base);
  }

  @media (min-width: 1024px) {
    .navbar-menu-container {
      display: block;
    }
    .navbar-cta {
      display: inline-flex;
    }
    .navbar-toggle {
      display: none;
    }
  }

  /* Mobile Open State */
  :global(.nav-open) .navbar-menu-container {
    display: flex;
    position: fixed;
    inset: 0;
    background: var(--color-bg);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 105;
  }

  :global(.nav-open) .navbar-menu {
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  :global(.nav-open) .navbar-link {
    font-size: var(--text-2xl);
    font-family: var(--font-display);
  }

  :global(.nav-open) .navbar-toggle-icon:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  :global(.nav-open) .navbar-toggle-icon:nth-child(2) { opacity: 0; }
  :global(.nav-open) .navbar-toggle-icon:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
</style>

<script>
  const toggle = document.querySelector('.navbar-toggle');
  const links = document.querySelectorAll('.navbar-link');
  const navbar = document.querySelector('.navbar');

  toggle?.addEventListener('click', () => {
    document.body.classList.toggle('nav-open');
    const isOpen = document.body.classList.contains('nav-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      document.body.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Ajouter la classe scrolled au scroll
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    if (currentScroll > 50) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
    lastScroll = currentScroll;
  }, { passive: true });
</script>
