---
/**
 * CanvasLiquid — Effet fluide WebGL pour section Hero
 */
interface Props {
  color?: [number, number, number];
  intensity?: number;
  distortion?: number;
}

const { color = [1.0, 0.84, 0.0], intensity = 1.5, distortion = 0.25 } = Astro.props;
---

<div class="canvas-liquid-container">
  <div class="canvas-liquid-content" id="liquid-content">
    <slot />
  </div>
  <canvas class="canvas-liquid-source" id="liquid-source"></canvas>
  <canvas class="canvas-liquid-output" id="liquid-output" aria-hidden="true"></canvas>
</div>

<style>
  .canvas-liquid-container {
    position: absolute;
    inset: 0;
    overflow: visible; /* Changé de hidden à visible */
    pointer-events: none;
    z-index: 0;
  }

  .canvas-liquid-content {
    position: relative;
    width: 100%;
    height: 100%;
    pointer-events: auto; /* Permet les clics sur le contenu */
  }

  .canvas-liquid-source {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
  }

  .canvas-liquid-output {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: screen;
  }
</style>

<script type="module" client:load define:vars={{ color, intensity, distortion }}>
  (async () => {
    if (typeof window === 'undefined') return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const outputCanvas = document.getElementById('liquid-output');
    if (prefersReducedMotion && outputCanvas) {
      outputCanvas.style.display = 'none';
      return;
    }

    try {
      const { createLiquid } = await import(new URL('/lmv-portfolio/lib/Liquid.js', window.location.origin).href);
      const sourceCanvas = document.getElementById('liquid-source');
      const content = document.getElementById('liquid-content');

      if (!sourceCanvas || !outputCanvas || !content) return;

      const instance = createLiquid(
        { source: sourceCanvas, content, output: outputCanvas },
        {
          color,
          intensity,
          distortion,
          densityDissipation: 0.92,
          velocityDissipation: 0.98,
          curl: 2.5,
          blend: 8,
          rainbow: false,
        }
      );

      if (!instance) {
        outputCanvas.style.display = 'none';
      } else {
        let tick = 0;
        const idleInterval = setInterval(() => {
          tick += 0.02;
          const x = 0.3 + 0.4 * Math.sin(tick * 0.7);
          const y = 0.3 + 0.4 * Math.cos(tick * 0.5);
          instance.splat(x, y, Math.sin(tick) * 0.01, Math.cos(tick) * 0.01);
        }, 50);

        window.addEventListener('beforeunload', () => {
          instance.destroy();
          clearInterval(idleInterval);
        });
      }
    } catch (e) {
      console.error('[CanvasLiquid] Error:', e);
      if (outputCanvas) outputCanvas.style.display = 'none';
    }
  })();
</script>