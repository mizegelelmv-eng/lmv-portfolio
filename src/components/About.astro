---
import { PERSONAL } from '../config';
---

<section id="apropos" class="section" aria-labelledby="about-title">
  <div class="container">
    <div class="about-grid">
      <div class="about-visual reveal">
        <div class="about-avatar">
          <div class="about-avatar-inner">
            <span>LMV</span>
          </div>
          <div class="about-avatar-accent"></div>
        </div>
        <div class="about-location">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span>{PERSONAL.location !== 'À DEFINIR' ? PERSONAL.location : 'France'}</span>
        </div>
      </div>

      <div class="about-content">
        <p class="reveal section-eyebrow">À propos</p>
        <h2 id="about-title" class="reveal reveal-delay-1 section-title">
          Développeur web<br />freelance passionné
        </h2>
        <div class="gold-line reveal reveal-delay-2" aria-hidden="true"></div>
        <p class="reveal reveal-delay-2 about-text">
          {PERSONAL.bio}
        </p>
        <p class="reveal reveal-delay-3 about-text about-text--alt">
          Je conçois et développe des sites et applications web sur-mesure,
          en privilégiant la performance, l'accessibilité et l'expérience utilisateur.
          Chaque projet est une collaboration : j'aime comprendre vos besoins
          pour vous proposer des solutions qui dépassent vos attentes.
        </p>
        <div class="reveal reveal-delay-4 about-actions">
          <a href="#contact" class="btn btn-primary">Discutons de votre projet</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-eyebrow {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 768px) {
    .about-grid { grid-template-columns: 1fr 1.4fr; gap: var(--space-16); }
  }

  .about-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .about-avatar {
    position: relative;
    width: 180px;
    height: 180px;
  }

  .about-avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-bg-card) 0%, var(--color-bg-elevated) 100%);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    color: var(--color-gold);
    position: relative;
    z-index: 1;
  }

  .about-avatar-accent {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid var(--color-gold);
    opacity: 0.3;
  }

  .about-location {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .about-location svg {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .about-text {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .about-text--alt {
    color: var(--color-text-dim);
    font-size: var(--text-sm);
  }

  .about-actions {
    margin-top: var(--space-6);
  }
</style>
