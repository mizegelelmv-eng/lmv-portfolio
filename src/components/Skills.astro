---
import { SKILLS } from '../config';
import SectionParticleReveal from './SectionParticleReveal.astro';
---

<SectionParticleReveal radius={300}>
  <section id="competences" class="section section-alt" aria-labelledby="skills-title">
    <div class="container">
      <span class="section-eyebrow">Compétences</span>
      <h2 id="skills-title" class="section-title">Technologies & Outils</h2>
      <div class="gold-line"></div>
      <p class="section-subtitle">Un écosystème technique maîtrisé pour des solutions performantes.</p>

      <div class="grid grid-3">
        <div class="glass-card">
          <h3 class="skill-category">Frontend</h3>
          <ul class="skill-list">
            {SKILLS.frontend.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <div class="glass-card">
          <h3 class="skill-category">Backend</h3>
          <ul class="skill-list">
            {SKILLS.backend.map(item => <li>{item}</li>)}
          </ul>
        </div>
        <div class="glass-card">
          <h3 class="skill-category">Outils</h3>
          <ul class="skill-list">
            {SKILLS.tools.map(item => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</SectionParticleReveal>

<style>
  .skill-category {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-gold);
    margin-bottom: var(--space-6);
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .skill-list li {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding-left: var(--space-4);
    position: relative;
  }

  .skill-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    background: var(--color-gold);
    border-radius: 50%;
  }
</style>