---
/**
 * GlassCard — Carte avec effet de verre dépoli au survol
 * Chaque instance reçoit un ID unique pour initialiser son propre wrapper
 */
interface Props {
  targetSelector?: string;
  size?: number;
  ior?: number;
  opacity?: number;
  key?: any;
}

const { targetSelector = '[data-glass-target]', size = 100, ior = 1.45, opacity = 0.6, key } = Astro.props;
// Générer un ID unique stable pour cette instance de composant
const instanceId = `glass-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="glass-card-wrapper" data-glass-wrapper data-glass-id={Math.random().toString(36).slice(2, 9)}>
  <div class="glass-card">
    <slot />
  </div>
</div>

<style>
  .glass-card-wrapper {
    position: relative;
    height: 100%;
  }

  /* Canvases injectés dynamiquement */
  :global(.glass-canvas-source) {
    position: fixed;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
  }

  :global(.glass-canvas-output) {
    position: fixed;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    z-index: 1000;
  }
</style>

<script type="module" client:load define:vars={{ targetSelector, size, ior }}>
  (async () => {
    if (typeof window === 'undefined') return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    await new Promise(r => requestAnimationFrame(r));

    // Find THIS component's wrapper — each script is inside a [data-scroll-reveal] after its wrapper
    const wrappers = document.querySelectorAll('[data-glass-wrapper]:not([data-glass-initialized])');
    let wrapper = null;
    document.querySelectorAll('script[type="module"]').forEach(script => {
      if (!script.textContent.includes('createGlass')) return;
      const scrollReveal = script.closest('[data-scroll-reveal]');
      if (!scrollReveal) return;
      const card = scrollReveal.querySelector(':scope > .glass-card-wrapper');
      if (card && !card.hasAttribute('data-glass-initialized')) wrapper = card;
    });
    if (!wrapper || wrapper.hasAttribute('data-glass-initialized')) return;
    wrapper.setAttribute('data-glass-initialized', '');

    const targetSelector = "[data-glass-target]";
    const content = wrapper.querySelector<HTMLElement>(targetSelector);
    if (!content) return;

    const sourceCanvas = document.createElement('canvas');
    sourceCanvas.className = 'glass-canvas-source';
    sourceCanvas.style.position = 'fixed';
    sourceCanvas.style.top = '0';
    sourceCanvas.style.left = '0';
    sourceCanvas.style.width = '1px';
    sourceCanvas.style.height = '1px';
    document.body.appendChild(sourceCanvas);

    const outputCanvas = document.createElement('canvas');
    outputCanvas.className = 'glass-canvas-output';
    outputCanvas.style.position = 'fixed';
    outputCanvas.style.top = '0';
    outputCanvas.style.left = '0';
    outputCanvas.style.width = '1px';
    outputCanvas.style.height = '1px';
    document.body.appendChild(outputCanvas);

    try {
      const { createGlass } = await import(new URL('/lmv-portfolio/lib/Glass.js', window.location.origin).href);
      const instance = createGlass(
        { source: sourceCanvas, content, output: outputCanvas },
        {
          shape: 'circle',
          size,
          ior,
          edge: 0.6,
          bevel: 3,
          depth: 180,
          aberration: 0.6,
          blur: 0.3,
          reflection: 0.8,
          shine: 0.05,
          zoom: 1.4,
          targets: targetSelector,
          follow: 0.35,
        }
      );
      if (!instance) {
        sourceCanvas.remove();
        outputCanvas.remove();
        return;
      }
      window.addEventListener('beforeunload', () => instance.destroy());
    } catch (e) {
      sourceCanvas.remove();
      outputCanvas.remove();
    }
  })();
</script>
