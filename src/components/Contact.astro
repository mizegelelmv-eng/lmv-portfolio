---
import { PERSONAL, SOCIAL } from '../config';
import SectionParticleReveal from './SectionParticleReveal.astro';
---

<SectionParticleReveal radius={300}>
  <section id="contact" class="section section-alt" aria-labelledby="contact-title">
    <div class="container">
      <span class="section-eyebrow">Contact</span>
      <h2 id="contact-title" class="section-title">Discutons de votre projet</h2>
      <div class="gold-line"></div>

      <div class="grid grid-2">
        <div class="contact-info">
          <p class="section-subtitle">Je suis disponible pour de nouveaux défis. Contactez-moi pour un échange.</p>
          <a href={`mailto:${PERSONAL.email}`} class="contact-link">{PERSONAL.email}</a>
          <a href={`https://wa.me/${PERSONAL.whatsapp}`} class="contact-link">WhatsApp</a>
        </div>

        <div class="glass-card contact-form-placeholder">
          <p>Un formulaire de contact sécurisé sera bientôt disponible ici.</p>
        </div>
      </div>
    </div>
  </section>
</SectionParticleReveal>

<style>
  .contact-link {
    display: block;
    font-size: var(--text-2xl);
    font-family: var(--font-display);
    color: var(--color-gold);
    margin-bottom: var(--space-4);
  }

  .contact-form-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 200px;
    color: var(--color-text-muted);
  }
</style>