---
/**
 * Crystal — Élément décoratif cristal transparent à facettes géométriques
 */
interface Props {
  size?: number;
  opacity?: number;
  rotation?: number;
  delay?: number;
}

const { size = 120, opacity = 0.4, rotation = 15, delay = 0 } = Astro.props;
---

<div
  class="crystal"
  style="--crystal-size: {size}px; --crystal-opacity: {opacity}; --crystal-rotation: {rotation}deg; --crystal-delay: {delay}ms;"
  aria-hidden="true"
>
  <svg viewBox="0 0 100 120" xmlns="http://www.w3.org/2000/svg">
    {/* Facette principale - haut */}
    <polygon
      points="50,5 90,45 50,35 10,45"
      fill="rgba(245, 215, 122, 0.06)"
      stroke="rgba(245, 215, 122, 0.15)"
      stroke-width="0.5"
    />
    {/* Facette gauche */}
    <polygon
      points="10,45 50,35 35,95 5,70"
      fill="rgba(245, 215, 122, 0.04)"
      stroke="rgba(245, 215, 122, 0.12)"
      stroke-width="0.5"
    />
    {/* Facette droite */}
    <polygon
      points="90,45 50,35 65,95 95,70"
      fill="rgba(245, 215, 122, 0.05)"
      stroke="rgba(245, 215, 122, 0.12)"
      stroke-width="0.5"
    />
    {/* Facette bas-gauche */}
    <polygon
      points="5,70 35,95 50,115 20,95"
      fill="rgba(245, 215, 122, 0.03)"
      stroke="rgba(245, 215, 122, 0.1)"
      stroke-width="0.5"
    />
    {/* Facette bas-droite */}
    <polygon
      points="95,70 65,95 50,115 80,95"
      fill="rgba(245, 215, 122, 0.04)"
      stroke="rgba(245, 215, 122, 0.1)"
      stroke-width="0.5"
    />
    {/* Reflet doré sur arête */}
    <line
      x1="50" y1="5" x2="50" y2="35"
      stroke="rgba(245, 215, 122, 0.25)"
      stroke-width="1"
    />
    <line
      x1="50" y1="35" x2="10" y2="45"
      stroke="rgba(245, 215, 122, 0.15)"
      stroke-width="0.5"
    />
  </svg>
</div>

<style>
  .crystal {
    width: var(--crystal-size);
    height: calc(var(--crystal-size) * 1.2);
    opacity: var(--crystal-opacity);
    transform: rotate(var(--crystal-rotation));
    transition: opacity 1.2s ease, transform 1.2s ease;
    pointer-events: none;
    flex-shrink: 0;
  }

  .crystal.visible {
    opacity: var(--crystal-opacity);
    transform: rotate(var(--crystal-rotation)) translateY(0);
  }

  /* Réduction du mouvement pour accessibilité */
  @media (prefers-reduced-motion: reduce) {
    .crystal {
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .crystal {
      --crystal-size: 80px;
      --crystal-rotation: 0deg;
    }
  }
</style>
