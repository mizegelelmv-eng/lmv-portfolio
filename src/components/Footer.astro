---
import { PERSONAL, SOCIAL } from '../config';
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-logo">LMV Digital</span>
        <p class="footer-bio">{PERSONAL.bio}</p>
      </div>

      <nav class="footer-links" aria-label="Navigation pied de page">
        <h4 class="footer-heading">Navigation</h4>
        <a href="#apropos">À propos</a>
        <a href="#competences">Compétences</a>
        <a href="#projets">Projets</a>
        <a href="#services">Services</a>
        <a href="#processus">Processus</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="footer-social">
        <h4 class="footer-heading">Social</h4>
        <div class="social-links">
          {SOCIAL.github && <a href={SOCIAL.github} target="_blank" rel="noopener">GitHub</a>}
          {SOCIAL.linkedin && <a href={SOCIAL.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {PERSONAL.fullName}. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    padding: var(--space-20) 0 var(--space-10);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-16);
  }

  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: 2fr 1fr 1fr; }
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-gold);
    display: block;
    margin-bottom: var(--space-4);
  }

  .footer-bio {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 300px;
  }

  .footer-heading {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .footer-links, .footer-social {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-links a, .social-links a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .footer-links a:hover, .social-links a:hover {
    color: var(--color-gold);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }
</style>