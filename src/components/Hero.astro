---
import { SITE } from '../config';
import LiquidHero from './LiquidHero.astro';
---

<section class="hero" aria-label="Accueil">
  <LiquidHero color={[0.83, 0.69, 0.22]} intensity={1.2} distortion={0.3}>
    <div class="hero-background-fallback"></div>
  </LiquidHero>

  <div class="container hero-content">
    <span class="section-eyebrow reveal">LMV Digital</span>
    <h1 class="hero-title reveal reveal-delay-1">
      Développeur Web <span class="text-gold">Freelance</span>
    </h1>
    <p class="hero-description reveal reveal-delay-2">
      Je conçois des expériences numériques <span class="text-white">modernes</span>,
      performantes et <span class="text-white">sur-mesure</span> pour propulser votre activité.
    </p>
    <div class="hero-actions reveal reveal-delay-3">
      <a href="#projets" class="btn btn-primary">Voir mes projets</a>
      <a href="#contact" class="btn btn-outline">Me contacter</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding-top: var(--nav-height);
    overflow: hidden;
  }

  .hero-background-fallback {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(212, 175, 55, 0.05), transparent 50%);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 850px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-4xl), 8vw, var(--text-5xl));
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .text-gold {
    color: var(--color-gold);
  }

  .text-white {
    color: var(--color-white);
  }

  .hero-description {
    font-size: clamp(var(--text-base), 2vw, var(--text-lg));
    color: var(--color-text-muted);
    max-width: 600px;
    margin-bottom: var(--space-10);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>