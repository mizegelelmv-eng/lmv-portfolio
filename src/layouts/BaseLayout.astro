---
import { PERSONAL, SITE } from '../config';
import Head from '../components/Head.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollRevealInitializer from '../components/ScrollRevealInitializer.astro';

import '../styles/global.css';
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <script>document.documentElement.classList.remove('no-js');</script>
    <ScrollRevealInitializer />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}${SITE.favicon}`} />
    <meta name="generator" content={Astro.generator} />
    <title>{SITE.title}</title>
    <meta name="description" content={SITE.description} />
    <meta name="author" content={PERSONAL.fullName !== 'À DEFINIR' ? PERSONAL.fullName : 'LMV'} />
    <meta name="robots" content="index, follow" />
    <Head />
  </head>
  <body>
    <a href="#main-content" class="sr-only">Aller au contenu principal</a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>